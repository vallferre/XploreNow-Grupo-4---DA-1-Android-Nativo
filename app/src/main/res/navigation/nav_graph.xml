<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/exploreFragment">

    <fragment
        android:id="@+id/exploreFragment"
        android:name="ar.edu.uadexplorenow.ExploreFragment"
        android:label="@string/explore_title"
        tools:layout="@layout/activity_explore">
        <action
            android:id="@+id/action_exploreFragment_to_activityDetailFragment"
            app:destination="@id/activityDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/activityDetailFragment"
        android:name="ar.edu.uadexplorenow.ActivityDetailFragment"
        android:label="@string/detail_screen_title"
        tools:layout="@layout/activity_activity_detail">
        <argument
            android:name="activity_id"
            app:argType="string"
            app:nullable="false" />
    </fragment>
</navigation>
