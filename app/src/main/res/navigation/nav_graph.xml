<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="ar.edu.uadexplorenow.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <!-- Ir al registro -->
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />

        <!-- Ir al login con OTP -->
        <action
            android:id="@+id/action_login_to_otp_login"
            app:destination="@id/otpLoginFragment" />

        <!-- Login exitoso → home (limpia el stack de auth) -->
        <action
            android:id="@+id/action_auth_to_home"
            app:destination="@id/exploreFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="ar.edu.uadexplorenow.ui.auth.RegisterFragment"
        android:label="Registro"
        tools:layout="@layout/fragment_register">

        <!-- Registro exitoso → home (también limpia auth) -->
        <action
            android:id="@+id/action_auth_to_home"
            app:destination="@id/exploreFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/otpLoginFragment"
        android:name="ar.edu.uadexplorenow.ui.auth.OtpLoginFragment"
        android:label="Login OTP"
        tools:layout="@layout/fragment_otp_login">

        <!-- OTP login exitoso → home (limpia el stack de auth) -->
        <action
            android:id="@+id/action_auth_to_home"
            app:destination="@id/exploreFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

        <!-- Ir al registro desde OTP login -->
        <action
            android:id="@+id/action_otp_login_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/exploreFragment"
        android:name="ar.edu.uadexplorenow.ui.explore.ExploreFragment"
        android:label="@string/explore_title"
        tools:layout="@layout/activity_explore">
        <action
            android:id="@+id/action_exploreFragment_to_activityDetailFragment"
            app:destination="@id/activityDetailFragment" />
        <action
            android:id="@+id/action_exploreFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_exploreFragment_to_activityHistoryFragment"
            app:destination="@id/activityHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="ar.edu.uadexplorenow.ui.profile.ProfileFragment"
        android:label="@string/profile_title"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_activityHistoryFragment"
            app:destination="@id/activityHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/activityHistoryFragment"
        android:name="ar.edu.uadexplorenow.ui.history.ActivityHistoryFragment"
        android:label="@string/history_title"
        tools:layout="@layout/fragment_activity_history">
        <action
            android:id="@+id/action_activityHistoryFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_activityHistoryFragment_to_reservationDetailFragment"
            app:destination="@id/reservationDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/activityDetailFragment"
        android:name="ar.edu.uadexplorenow.ui.explore.ActivityDetailFragment"
        android:label="@string/detail_screen_title"
        tools:layout="@layout/activity_activity_detail">
        <argument
            android:name="activity_id"
            app:argType="string"
            app:nullable="false" />
    </fragment>

    <fragment
        android:id="@+id/reservationDetailFragment"
        android:name="ar.edu.uadexplorenow.ui.reservations.ReservationDetailFragment"
        android:label="@string/reservation_detail_title"
        tools:layout="@layout/fragment_reservation_detail">
        <argument
            android:name="reservation_id"
            app:argType="string"
            app:nullable="false" />
    </fragment>
</navigation>
