<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvReviewDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:text="@string/reservation_review_dialog_title"
        android:textColor="@color/explore_title"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="@string/reservation_review_activity_label"
        android:textColor="@color/explore_title"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/ratingActivityRow"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/starActivity1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reservation_review_star_1"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_outline" />

        <ImageButton
            android:id="@+id/starActivity2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reservation_review_star_2"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_outline" />

        <ImageButton
            android:id="@+id/starActivity3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reservation_review_star_3"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_outline" />

        <ImageButton
            android:id="@+id/starActivity4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reservation_review_star_4"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_outline" />

        <ImageButton
            android:id="@+id/starActivity5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reservation_review_star_5"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_outline" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="@string/reservation_review_guide_label"
        android:textColor="@color/explore_title"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/ratingGuideRow"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/starGuide1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reservation_review_star_1"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_outline" />

        <ImageButton
            android:id="@+id/starGuide2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reservation_review_star_2"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_outline" />

        <ImageButton
            android:id="@+id/starGuide3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reservation_review_star_3"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_outline" />

        <ImageButton
            android:id="@+id/starGuide4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reservation_review_star_4"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_outline" />

        <ImageButton
            android:id="@+id/starGuide5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/reservation_review_star_5"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_outline" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="@string/reservation_review_comment_label"
        android:textColor="@color/explore_title"
        android:textSize="15sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etReviewComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:gravity="top|start"
        android:hint="@string/reservation_review_comment_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="300"
        android:minHeight="112dp"
        android:padding="12dp" />

    <TextView
        android:id="@+id/tvReviewCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:text="@string/reservation_review_count_initial"
        android:textColor="@color/explore_muted"
        android:textSize="12sp" />
</LinearLayout>
