<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stepOtpRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/otp_register_verify_subtitle"
        android:textColor="#888888"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_card_rounded"
        android:elevation="4dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvOtpInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/otp_sent_to"
            android:textColor="#555555"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etOtp1"
                style="@style/OtpField" />

            <EditText
                android:id="@+id/etOtp2"
                style="@style/OtpField" />

            <EditText
                android:id="@+id/etOtp3"
                style="@style/OtpField" />

            <EditText
                android:id="@+id/etOtp4"
                style="@style/OtpField" />

            <EditText
                android:id="@+id/etOtp5"
                style="@style/OtpField" />

            <EditText
                android:id="@+id/etOtp6"
                style="@style/OtpField" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOtpTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="05:00"
            android:textColor="#1A1A2E"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOtpVerify"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"
            android:enabled="false"
            android:letterSpacing="0.1"
            android:text="@string/otp_verify_btn"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOtpResend"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_secondary"
            android:backgroundTint="@null"
            android:enabled="false"
            android:text="@string/otp_resend_btn"
            android:textColor="#1A1A2E"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOtpBackToForm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/otp_back_to_form"
            android:textColor="#E63946"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
