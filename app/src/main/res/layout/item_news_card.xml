<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="248dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/explore_chip_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNewsCover"
            android:layout_width="match_parent"
            android:layout_height="138dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:src="@color/explore_search_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvNewsTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_featured_tag"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/explore_title"
                android:textSize="11sp"
                tools:text="Oferta" />

            <TextView
                android:id="@+id/tvNewsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxLines="2"
                android:textColor="@color/explore_title"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Descuentos para escapadas de fin de semana" />

            <TextView
                android:id="@+id/tvNewsBrief"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="3"
                android:textColor="@color/explore_muted"
                android:textSize="13sp"
                tools:text="Nuevos destinos, rebajas y experiencias destacadas para viajar este mes." />

            <TextView
                android:id="@+id/tvNewsMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/explore_price_green"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Bariloche" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
